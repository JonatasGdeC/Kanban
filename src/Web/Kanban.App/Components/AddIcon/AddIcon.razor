@{
    (int defaultW, int defaultH, string viewBox) = Meta(icon: Name);
    int  w    = Width  ?? defaultW;
    int  h    = Height ?? defaultH;
    string fc = Fill ?? "currentColor";
}

<svg width="@w"
     height="@h"
     viewBox="@viewBox"
     xmlns="http://www.w3.org/2000/svg"
     class="@CssClass"
     style="@Style"
     aria-hidden="true">
    @switch (Name)
    {
        case KanbanIcon.Logo:
            <g fill="@(Fill ?? "#635FC7")" fill-rule="evenodd">
                <rect width="6" height="25" rx="2"/>
                <rect x="9"  y="0" width="6" height="19" rx="2"/>
                <rect x="18" y="0" width="6" height="12" rx="2"/>
            </g>
            break;

        case KanbanIcon.Board:
            <path fill="@fc"
                  d="M0 2.889A2.889 2.889 0 0 1 2.889 0H13.11A2.889 2.889 0 0 1 16 2.889V13.11
                     A2.888 2.888 0 0 1 13.111 16H2.89A2.889 2.889 0 0 1 0 13.111V2.89Z
                     m1.333 5.555v4.667c0 .859.697 1.556 1.556 1.556h6.889V8.444H1.333Z
                     m8.445-1.333V1.333h-6.89A1.556 1.556 0 0 0 1.334 2.89V7.11h8.445Z
                     m4.889-1.333H11.11v4.444h3.556V5.778Z
                     m0 5.778H11.11v3.11h2a1.556 1.556 0 0 0 1.556-1.555v-1.555Z
                     m0-7.112V2.89a1.555 1.555 0 0 0-1.556-1.556h-2v3.111h3.556Z"/>
            break;

        case KanbanIcon.EllipsisVertical:
            <g fill="@fc" fill-rule="evenodd">
                <circle cx="2.308" cy="2.308"  r="2.308"/>
                <circle cx="2.308" cy="10"     r="2.308"/>
                <circle cx="2.308" cy="17.692" r="2.308"/>
            </g>
            break;

        case KanbanIcon.Eye:
            <path fill="@fc" fill-rule="evenodd"
                  d="M15.815 4.434A9.055 9.055 0 0 0 8 0 9.055 9.055 0 0 0 .185 4.434
                     a1.333 1.333 0 0 0 0 1.354A9.055 9.055 0 0 0 8 10.222
                     a9.055 9.055 0 0 0 7.815-4.434 1.333 1.333 0 0 0 0-1.354Z
                     M8 8.89A3.776 3.776 0 0 1 4.222 5.11 3.776 3.776 0 0 1 8 1.333
                     a3.776 3.776 0 0 1 3.778 3.778A3.776 3.776 0 0 1 8 8.89Z
                     m0-6.222a2.444 2.444 0 1 0 0 4.888 2.444 2.444 0 0 0 0-4.888Z"/>
            break;

        case KanbanIcon.EyeOff:
            <path fill="@fc" fill-rule="evenodd"
                  d="M8.522 11.223a4.252 4.252 0 0 1-3.654-5.22l3.654 5.22Z
                     M9 12.25A8.685 8.685 0 0 1 1.5 8a8.612 8.612 0 0 1 2.76-3.321
                     l-1.21-1.54A10.149 10.149 0 0 0 0 8a10.149 10.149 0 0 0 9 5.5
                     9.9 9.9 0 0 0 1.3-.09l-1.76-2.51A4.256 4.256 0 0 1 9 12.25Z
                     m5.5-3.25a8.52 8.52 0 0 1-.89 1.377l1.206 1.547
                     A10.148 10.148 0 0 0 18 8c0-2.832-1.506-5.355-3.899-7H13.5
                     a8.503 8.503 0 0 1 1 1.5A8.613 8.613 0 0 1 16.5 8Z
                     M12.5 8a3.5 3.5 0 0 0-3.5-3.5 3.495 3.495 0 0 0-3.5 3.5
                     3.5 3.5 0 0 0 3.5 3.5 3.5 3.5 0 0 0 3.5-3.5Z"/>
            break;

        case KanbanIcon.Sun:
            <path fill="@fc" fill-rule="evenodd"
                  d="M9.167 15.833a6.667 6.667 0 1 0 0-13.333 6.667 6.667 0 0 0 0 13.333Z
                     m0-1.667a5 5 0 1 1 0-10 5 5 0 0 1 0 10Z
                     M8.333 0h1.667v2.5H8.333V0Z
                     M8.333 15.833h1.667v2.5H8.333v-2.5Z
                     M0 8.333h2.5v1.667H0V8.333Z
                     M15.833 8.333h2.5v1.667h-2.5V8.333Z
                     M2.929 2.929l1.178 1.178-1.178 1.178L1.75 4.107 2.929 2.929Z
                     m11.785 11.785 1.179 1.179-1.179 1.178-1.178-1.178 1.178-1.179Z
                     m-11.785 0 1.178-1.179 1.179 1.179-1.179 1.178-1.178-1.178Z
                     M14.714 2.929l1.178 1.178-1.178 1.178-1.179-1.178 1.179-1.178Z"/>
            break;

        case KanbanIcon.Moon:
            <path fill="@fc" fill-rule="evenodd"
                  d="M6.474.028C2.343 1.027-.504 4.716.065 8.89c.582 4.256 4.378 7.318
                     8.783 7.096 2.977-.15 5.229-1.765 6.631-4.123a7.065 7.065 0 0 1-1.085.08
                     6.953 6.953 0 0 1-4.944-2.049A6.978 6.978 0 0 1 7.412 4.91
                     c0-1.868.737-3.668 2.05-5L6.475.028Z"/>
            break;

        case KanbanIcon.ChevronDown:
            <path stroke="@(Stroke ?? Fill ?? "#635FC7")"
                  stroke-width="2" fill="none" d="m1 1 4 4 4-4"/>
            break;

        case KanbanIcon.Close:
            <g fill="@fc" fill-rule="evenodd">
                <path d="m12.728 0 2.122 2.122L2.122 14.85 0 12.728z"/>
                <path d="M0 2.122 2.122 0 14.85 12.728l-2.122 2.122z"/>
            </g>
            break;

        case KanbanIcon.User:
            <g fill="@fc" fill-rule="evenodd">
                <circle cx="8" cy="5" r="4"/>
                <path d="M0 16c0-4.418 3.582-8 8-8s8 3.582 8 8H0Z"/>
            </g>
            break;

        case KanbanIcon.LogOut:
            <g fill="none" stroke="@(Stroke ?? fc)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 2H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h6"/>
                <polyline points="12 15 15 12 12 9"/>
                <line x1="5" y1="12" x2="15" y2="12"/>
            </g>
            break;
    }
</svg>

@code {
    /// <summary>Ícone a renderizar.</summary>
    [Parameter, EditorRequired] public KanbanIcon Name { get; set; }

    /// <summary>Largura em px. Se omitido usa o tamanho padrão do ícone.</summary>
    [Parameter] public int? Width { get; set; }

    /// <summary>Altura em px. Se omitido usa o tamanho padrão do ícone.</summary>
    [Parameter] public int? Height { get; set; }

    /// <summary>Cor de preenchimento (fill). Padrão: "currentColor".</summary>
    [Parameter] public string? Fill { get; set; }

    /// <summary>Cor do contorno (stroke). Usada somente em ChevronDown.</summary>
    [Parameter] public string? Stroke { get; set; }

    /// <summary>Classe CSS adicional aplicada ao elemento svg.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Estilo inline adicional aplicado ao elemento svg.</summary>
    [Parameter] public string? Style { get; set; }

    private static (int w, int h, string viewBox) Meta(KanbanIcon icon) => icon switch
    {
        KanbanIcon.Logo             => (24, 25, "0 0 24 25"),
        KanbanIcon.Board            => (16, 16, "0 0 16 16"),
        KanbanIcon.EllipsisVertical => ( 5, 20, "0 0 5 20"),
        KanbanIcon.Eye              => (16, 11, "0 0 16 11"),
        KanbanIcon.EyeOff           => (18, 16, "0 0 18 16"),
        KanbanIcon.Sun              => (19, 19, "0 0 19 19"),
        KanbanIcon.Moon             => (16, 16, "0 0 16 16"),
        KanbanIcon.ChevronDown      => (10,  7, "0 0 10 7"),
        KanbanIcon.Close            => (15, 15, "0 0 15 15"),
        KanbanIcon.User             => (16, 16, "0 0 16 16"),
        KanbanIcon.LogOut           => (16, 16, "0 0 16 16"),
        _                           => (16, 16, "0 0 16 16"),
    };
}
