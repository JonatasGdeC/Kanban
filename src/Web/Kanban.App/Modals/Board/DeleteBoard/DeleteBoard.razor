<div class="modal" @onclick:stopPropagation>
    <h2 class="modal-title modal-title--danger" style="margin-bottom:24px;">@ModalLocalizer[name: "DELETE_BOARD_TITLE"]</h2>
    <p class="modal-body-text">
        @ModalLocalizer[name: "DELETE_CONFIRM_PRE"] '<strong>@Board.Name</strong>' @ModalLocalizer[name: "DELETE_BOARD_CONFIRM_POST"]
    </p>
    <div class="modal-btn-row">
        <button type="button" class="btn-modal-danger" disabled="@_isSubmitting" @onclick="HandleDeleteBoard">
            @(_isSubmitting ? ModalLocalizer[name: "DELETING"] : ModalLocalizer[name: "DELETE_BTN"])
        </button>
        <button type="button" class="btn-modal-secondary" @onclick="@(ModalUseState.Close)">@ModalLocalizer[name: "CANCEL_BTN"]</button>
    </div>

    @if (_listFeedbacks.Any())
    {
        <ul class="auth-error">
            @foreach (string feedback in _listFeedbacks)
            {
                <li>@feedback</li>
            }
        </ul>
    }
</div>
