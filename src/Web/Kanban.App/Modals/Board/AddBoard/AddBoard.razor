@using Kanban.Communication.Requests.Column

<div class="modal" @onclick:stopPropagation>
    <h2 class="modal-title" style="margin-bottom:24px;">
        @ModalLocalizer[name: "ADD_BOARD_TITLE"]
    </h2>

    <div class="form-group">
        <label class="form-label">@ModalLocalizer[name: "BOARD_NAME_LABEL"]</label>
        <input class="form-input" type="text" placeholder="@ModalLocalizer[name: "BOARD_NAME_PLACEHOLDER"]" @bind="_boardRequest.Name" @bind:event="oninput"/>
    </div>

    <div class="form-group">
        <label class="form-label">@ModalLocalizer[name: "BOARD_COLUMNS_LABEL"]</label>
        @foreach (RegisterColumnRequest columnRequest in _columnRegisterRequest)
        {
            <div class="subtask-row">
                <input type="color" class="col-color-picker" value="@columnRequest.Color"
                       @oninput="@(e => columnRequest.Color = e.Value?.ToString() ?? columnRequest.Color)"/>
                <input class="form-input" type="text" placeholder="@ModalLocalizer[name: "COLUMN_PLACEHOLDER"]" @bind="@columnRequest.Name"/>
                <button type="button" class="btn-remove-subtask"
                        @onclick="@(() => AddRemoveRegisterColumnRequest(column: columnRequest))">
                    <AddIcon Name="KanbanIcon.Close"/>
                </button>
            </div>
        }

        <button type="button" class="btn-add-subtask" @onclick="@AddNewRegisterColumnRequest">@ModalLocalizer[name: "ADD_NEW_COLUMN_BTN"]</button>
    </div>

    <button type="button" class="btn-modal-primary"
            disabled="@(string.IsNullOrWhiteSpace(value: _boardRequest.Name) || _isSubmitting)"
            @onclick="@HandleSubmitBoard">
        @(_isSubmitting ? ModalLocalizer[name: "SAVING"] : ModalLocalizer[name: "CREATE_BOARD_BTN"])
    </button>

    @if (_listFeedbacks.Any())
    {
        <ul class="auth-error">
            @foreach (string feedback in _listFeedbacks)
            {
                <li>@feedback</li>
            }
        </ul>
    }
</div>
