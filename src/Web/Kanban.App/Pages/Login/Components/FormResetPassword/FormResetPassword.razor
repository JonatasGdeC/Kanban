@switch (_step)
{
    case ResetStep.Email:
        <div class="form-group">
            <label class="form-label">@LoginLocalizer[name: "RESET_EMAIL_LABEL"]</label>
            <input class="form-input" type="email" placeholder="@LoginLocalizer[name: "RESET_EMAIL_PLACEHOLDER"]"
                   @bind="_email" @bind:event="oninput"/>
        </div>

        <button type="button" class="btn-modal-primary auth-submit-btn"
                @onclick="@HandleSendEmail" disabled="@(!CanSubmitEmail)">
            @(_isSubmitting ? LoginLocalizer[name: "RESET_SENDING"] : LoginLocalizer[name: "RESET_SEND_CODE"])
        </button>
        break;

    case ResetStep.Code:
        <p class="reset-hint">
            @LoginLocalizer[name: "RESET_CODE_HINT"] <strong>@_email</strong>.<br/>
            @LoginLocalizer[name: "RESET_CODE_HINT2"]
        </p>

        <div class="form-group">
            <label class="form-label">@LoginLocalizer[name: "RESET_CODE_LABEL"]</label>
            <input class="form-input reset-code-input" type="text"
                   placeholder="000000" maxlength="6"
                   @bind="_code" @bind:event="oninput"/>
        </div>

        <button type="button" class="btn-modal-primary auth-submit-btn"
                @onclick="@HandleVerifyCode" disabled="@(!CanSubmitCode)">
            @(_isSubmitting ? LoginLocalizer[name: "RESET_VERIFYING"] : LoginLocalizer[name: "RESET_VERIFY_CODE"])
        </button>

        <p class="reset-resend-text">
            @LoginLocalizer[name: "RESET_DIDNT_RECEIVE"]
            <button type="button" class="auth-switch-link" @onclick="@HandleSendEmail">@LoginLocalizer[name: "RESET_RESEND"]</button>
        </p>
        break;

    /* ── Step 3: New password ────────────────────────── */
    case ResetStep.NewPassword:
        <div class="form-group">
            <label class="form-label">@LoginLocalizer[name: "RESET_NEW_PASSWORD_LABEL"]</label>
            <div class="input-password-wrapper">
                <input class="form-input" type="@(_showPwd ? "text" : "password")"
                       placeholder="@LoginLocalizer[name: "RESET_NEW_PASSWORD_PLACEHOLDER"]"
                       @bind="_newPassword" @bind:event="oninput"/>
                <button type="button" class="btn-toggle-pwd"
                        @onclick="@(() => _showPwd = !_showPwd)"
                        title="@(_showPwd ? LoginLocalizer[name: "HIDE_PASSWORD"] : LoginLocalizer[name: "SHOW_PASSWORD"])">
                    <AddIcon Name="@(_showPwd ? KanbanIcon.EyeOff : KanbanIcon.Eye)" Width="18" Height="13"/>
                </button>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">@LoginLocalizer[name: "RESET_CONFIRM_PASSWORD_LABEL"]</label>
            <input class="form-input" type="@(_showPwd ? "text" : "password")"
                   placeholder="@LoginLocalizer[name: "RESET_CONFIRM_PASSWORD_PLACEHOLDER"]"
                   @bind="_confirmPassword" @bind:event="oninput"/>
        </div>

        <button type="button" class="btn-modal-primary auth-submit-btn"
                @onclick="@HandleResetPassword" disabled="@(!CanSubmitNewPassword)">
            @(_isSubmitting ? LoginLocalizer[name: "RESET_SAVING"] : LoginLocalizer[name: "RESET_NEW_PASSWORD_BTN"])
        </button>
        break;

    /* ── Step 4: Success ─────────────────────────────── */
    case ResetStep.Success:
        <div class="reset-success">
            <div class="reset-success-icon">
                <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="32" fill="rgba(99,95,199,0.12)"/>
                    <path d="M20 33l9 9 15-16" stroke="#635FC7" stroke-width="2.5"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <p class="reset-success-title">@LoginLocalizer[name: "RESET_SUCCESS_TITLE"]</p>
            <p class="reset-success-desc">@LoginLocalizer[name: "RESET_SUCCESS_DESC"]</p>
        </div>

        <button type="button" class="btn-modal-primary auth-submit-btn"
                @onclick="@HandleBackToLogin">
            @LoginLocalizer[name: "RESET_BACK_TO_LOGIN"]
        </button>
        break;
}

@if (_listFeedbacks.Any())
{
    <ul class="auth-error">
        @foreach (string feedback in _listFeedbacks)
        {
            <li>@feedback</li>
        }
    </ul>
}
