@using Kanban.App.Components.AddLoading
@using Kanban.App.Pages.Default.Components.TaskCard
@using Kanban.Communication.Dtos
@inherits FluxorComponent

<div class="column @(DragColumnState.IsDragging && DragColumnState.HoveredColumnId == Column.Id && DragColumnState.DraggingColumn?.Id != Column.Id ? "column--swap-target" : string.Empty) @(DragColumnState.DraggingColumn?.Id == Column.Id ? "column--dragging" : string.Empty)"
     @ondragover:preventDefault
     @ondragover="@OnDragOverColumn"
     @ondrop="@HandleDrop">

    <div class="column-header @(DragColumnState.DraggingColumn?.Id == Column.Id ? "column-header--dragging" : string.Empty)"
         draggable="true"
         @ondragstart="@OnColumnDragStart"
         @ondragstart:stopPropagation
         @ondragend="@OnColumnDragEnd"
         @ondragend:stopPropagation>
        <span class="column-dot" style="background-color:@Column.Color"></span>
        <span class="column-name">@Column.Name (@ColumnTasks.Count)</span>
    </div>

    @for (int i = 0; i < ColumnTasks.Count; i++)
    {
        TaskDto task = ColumnTasks[index: i];
        int index = i;

        <div class="drop-zone @(_dropIndex == index && DragTaskState.IsDragging ? "drop-zone--active" : string.Empty)"
             @ondragover:preventDefault
             @ondragover="@(() => OnDragOverTask(index: index))"
             @ondragover:stopPropagation>
        </div>

        <TaskCard Task="@task" ColumnId="@Column.Id"/>
    }

    <div class="drop-zone @(_dropIndex == ColumnTasks.Count && DragTaskState.IsDragging ? "drop-zone--active" : string.Empty)"
         @ondragover:preventDefault
         @ondragover="@(() => OnDragOverTask(index: ColumnTasks.Count))"
         @ondragover:stopPropagation>
    </div>
    
    @if (_isLoading)
    {
        <AddLoading HeightContainer="100%"/>
    }
</div>
