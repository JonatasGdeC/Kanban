@inherits FluxorComponent

<div class="task-card @(DragTaskState.DraggingTask?.Id == Task.Id ? "task-card--dragging" : string.Empty)"
     draggable="true"
     @ondragstart="@OnDragStart"
     @ondragend="@OnDragEnd"
     @onclick="@OpenViewTask">
    <p class="task-card-title">@Task.Name</p>
    @if (TaskSubTasks.Any())
    {
        <p class="task-card-subtasks">
            @TaskSubTasks.Count(predicate: st => st.IsDone) @DefaultLocalizer[name: "OF_LABEL"] @TaskSubTasks.Count @DefaultLocalizer[name: "SUBTASKS_COUNT"]
        </p>
    }
</div>
