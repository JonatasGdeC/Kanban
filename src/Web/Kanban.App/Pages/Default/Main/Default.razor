@page "/"
@page "/{boardId:guid}"
@using Kanban.App.Components.AddLoading
@using Kanban.App.Pages.Default.Components.ColumnContainer
@using Kanban.Communication.Dtos
@inherits FluxorComponent

<PageTitle>Kanban @(BoardState.Value.Board != null ? $"- {BoardState.Value.Board.Name}" : null)</PageTitle>

<div class="columns-wrapper"
     @ondrop="@OnColumnDrop"
     @ondragover:preventDefault>
    @if (_isLoading)
    {
        <AddLoading/>
    }
    else if (!ColumnListState.Value.Columns.Any() || !BoardId.HasValue)
    {
        if (BoardId.HasValue)
        {
            <div class="empty-board">
                <p class="empty-board-text">@DefaultLocalizer[name: "EMPTY_BOARD_NO_COLUMNS"]</p>
                <button class="btn-add-task" @onclick="@OpenEditBoard">
                    @DefaultLocalizer[name: "EMPTY_BOARD_ADD_COLUMN"]
                </button>
            </div>
        }
        else
        {
            <div class="empty-board">
                <p class="empty-board-text">@DefaultLocalizer[name: "EMPTY_BOARD_NO_BOARD"]</p>
                <button class="btn-add-task" @onclick="@(() => ModalUseState.Open(dialog: ModalUseState.ModalType.AddBoard))">
                    @DefaultLocalizer[name: "EMPTY_BOARD_ADD_BOARD"]
                </button>
            </div>
        }
    }
    else
    {
        @foreach (ColumnDto col in ColumnListState.Value.Columns.OrderBy(keySelector: c => c.Order))
        {
            <ColumnContainer Column="@col"/>
        }

        <button class="new-column-btn" @onclick="@(OpenEditBoard)">
            @DefaultLocalizer[name: "NEW_COLUMN_BTN"]
        </button>
    }
</div>
